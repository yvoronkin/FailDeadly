EESchema-LIBRARY Version 2.3
#encoding utf-8
#SamacSys ECAD Model KX-9A
#/16085591/1602478/2.50/4/3/Crystal or Oscillator
DEF KX-9A Y 0 30 Y Y 1 F N
F0 "Y" 1450 300 50 H V L CNN
F1 "KX-9A" 1450 200 50 H V L CNN
F2 "KX9A" 1450 100 50 H I L CNN
F3 "https://www.geyer-electronic.com/fileadmin/user_upload/frequenz/quartz/KX-9A/GEYER-KX-9A.pdf" 1450 0 50 H I L CNN
F4 "7.680 ~ 300.0 MHz mode fundamental, 3rd overtone, 5th overtone operating temperature standard -20 ~ + 70C" 1450 -100 50 H I L CNN "Description"
F5 "1" 1450 -200 50 H I L CNN "Height"
F6 "Geyer" 1450 -300 50 H I L CNN "Manufacturer_Name"
F7 "KX-9A" 1450 -400 50 H I L CNN "Manufacturer_Part_Number"
F8 "" 1450 -500 50 H I L CNN "Mouser Part Number"
F9 "" 1450 -600 50 H I L CNN "Mouser Price/Stock"
F10 "" 1450 -700 50 H I L CNN "Arrow Part Number"
F11 "" 1450 -800 50 H I L CNN "Arrow Price/Stock"
DRAW
X CRYSTAL_1 1 0 -100 200 R 50 50 0 0 P
X GROUND_1 2 1600 -100 200 L 50 50 0 0 P
X CRYSTAL_2 3 1600 0 200 L 50 50 0 0 P
X GROUND_2 4 0 0 200 R 50 50 0 0 P
P 5 0 1 6 200 100 1400 100 1400 -200 200 -200 200 100 N
ENDDRAW
ENDDEF
#
#End Library

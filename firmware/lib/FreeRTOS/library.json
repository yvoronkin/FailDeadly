{
  "name": "FreeRTOS-Kernel-STM32F401",
  "version": "11.1.0",
  "build": {
    "srcDir": "FreeRTOS-Kernel",
    "includeDir" : "FreeRTOS-Kernel/include",
    "srcFilter": [
      "-<*>",

      "+<tasks.c>",
      "+<queue.c>",
      "+<list.c>",
      "+<timers.c>",
      "+<event_groups.c>",
      "+<stream_buffer.c>",
      
      "+<portable/MemMang/heap_4.c>",

      "+<portable/Common/mpu_wrappers_v2.c>",

      "-<portable/**/port.c>",
      "-<portable/**/mpu_wrappers_v2_asm.c>",

      "+<portable/GCC/ARM_CM4_MPU/port.c>",
      "+<portable/GCC/ARM_CM4_MPU/mpu_wrappers_v2_asm.c>"
    ],
    "flags": [
      "-IFreeRTOS-Kernel/include",
      "-IFreeRTOS-Kernel/portable/GCC/ARM_CM4_MPU",
      "-I../../include"
    ]
  },
  "frameworks": "stm32cube",
  "platforms": "ststm32"
}
